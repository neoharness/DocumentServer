#!/usr/bin/python3
"""Thin, deterministic launcher for the neoHarness Office native runtime."""

from __future__ import annotations

import argparse
import hashlib
import json
import mimetypes
import os
from pathlib import Path
import re
import selectors
import signal
import stat
import subprocess
import sys
import textwrap
import time
from typing import Sequence


WORKSPACE_ROOT = Path("/workspace")
INPUT_ROOT = WORKSPACE_ROOT / "input"
WORK_ROOT = WORKSPACE_ROOT / "work"
OUTPUT_ROOT = WORKSPACE_ROOT / "output"
ARTIFACT_READ_ROOTS = (INPUT_ROOT, WORK_ROOT, OUTPUT_ROOT)
DEFAULT_MANIFEST = OUTPUT_ROOT / "nh-office-manifest.json"
DEFAULT_TIMEOUT_SECONDS = 600.0
DEFAULT_DIAGNOSTIC_LIMIT = 64 * 1024

EXIT_USAGE = 64
EXIT_DATA = 65
EXIT_ENGINE = 70
EXIT_TIMEOUT = 124
EXIT_SIGNAL = 143
QUALITY_POLICY_SCHEMA = "ai.neoharness.office.quality-policy.v1"
ARTIFACT_PROVENANCE_SCHEMA = "ai.neoharness.office.artifact-provenance.v1"


# Every example must carry this bridge explanation verbatim so a model that
# reads any single topic learns the host-path contract.
BRIDGE_COMMENT = '''// "jsValue(inputPath)" and "jsValue(outputPath)" below are LITERAL Document
// Builder host bridges: keep the quotes and text exactly as written. The
// engine resolves the named JavaScript variable itself. Never pass a bare
// Argument.input or Argument.output inside a builder.*() call — native
// command arguments are parsed as quoted strings, not JavaScript, so the
// path would arrive empty and the save/open would fail.'''

EXAMPLES: dict[str, str] = {
    "xlsx-revise": BRIDGE_COMMENT + r'''
// Inspect the real workbook first. Replace the sheet and ranges below with
// coordinates established from that inspection; never assume A1 is a header.
var inputPath = Argument["input"];
var outputPath = Argument["output"];
var options = Argument["argument"] || {};

builder.OpenFile("jsValue(inputPath)");
var sheet = Api.GetSheet(options.sheet_name || "Sheet1");
if (!sheet) throw new Error("Requested worksheet does not exist");

var title = sheet.GetRange(options.title_range || "A1:H1");
title.SetFillColor(Api.CreateColorFromRGB(31, 78, 121));
title.SetFontColor(Api.CreateColorFromRGB(255, 255, 255));
title.SetBold(true);
title.SetWrapText(true);
title.SetAlignHorizontal("center");

// Use exact ranges and widths appropriate to the observed sheet.
sheet.GetRange(options.body_range || "A2:H40").SetFontSize(10);
sheet.GetRange(options.label_columns || "A:B").SetColumnWidth(18);
sheet.GetRange(options.value_columns || "C:H").SetColumnWidth(14);

builder.SaveFile("xlsx", "jsValue(outputPath)");
builder.CloseFile();''',
    "docx-revise": BRIDGE_COMMENT + r'''
var inputPath = Argument["input"];
var outputPath = Argument["output"];

builder.OpenFile("jsValue(inputPath)");
var document = Api.GetDocument();
// Inspect the document first, then use exact methods from word-apiBuilder.js.
builder.SaveFile("docx", "jsValue(outputPath)");
builder.CloseFile();''',
    "pptx-revise": BRIDGE_COMMENT + r'''
var inputPath = Argument["input"];
var outputPath = Argument["output"];

builder.OpenFile("jsValue(inputPath)");
var presentation = Api.GetPresentation();
// Inspect masters, layouts, slides, placeholders, charts, and notes first.
builder.SaveFile("pptx", "jsValue(outputPath)");
builder.CloseFile();''',
    "pdf-revise": BRIDGE_COMMENT + r'''
var inputPath = Argument["input"];
var outputPath = Argument["output"];

builder.OpenFile("jsValue(inputPath)");
var document = Api.GetDocument();
// Inspect pages, forms, annotations, signatures, and permissions first.
builder.SaveFile("pdf", "jsValue(outputPath)");
builder.CloseFile();''',
    "docx-create": BRIDGE_COMMENT + r'''
// Native from-scratch Word document. No input file is opened.
builder.CreateFile("docx");
var document = Api.GetDocument();
document.GetElement(0).AddText("Title established from inspected evidence");
var paragraph = Api.CreateParagraph();
paragraph.AddText("Body text. Build real content from the workspace evidence");
document.Push(paragraph);
// Exact paragraph/run/table methods: word-apiBuilder.js. Keep builder.*()
// calls at the top level of the script; a builder.*() line inside an if/try
// block splits the surrounding JavaScript into broken fragments.
var outputPath = Argument["output"];
builder.SaveFile("docx", "jsValue(outputPath)");
builder.CloseFile();''',
    "xlsx-create": BRIDGE_COMMENT + r'''
// Native from-scratch workbook. No input file is opened.
builder.CreateFile("xlsx");
var sheet = Api.GetActiveSheet();
sheet.SetName("Summary");
sheet.GetRange("A1").SetValue("Label");
sheet.GetRange("B1").SetValue(21);
sheet.GetRange("B2").SetValue(2);
sheet.GetRange("B3").SetValue("=B1*B2");
// Exact range/format methods: cell-apiBuilder.js.
var outputPath = Argument["output"];
builder.SaveFile("xlsx", "jsValue(outputPath)");
builder.CloseFile();''',
    "pptx-create": BRIDGE_COMMENT + r'''
// Native from-scratch presentation. No input file is opened.
builder.CreateFile("pptx");
var presentation = Api.GetPresentation();
var slide = presentation.GetSlideByIndex(0);
slide.RemoveAllObjects();
var fill = Api.CreateSolidFill(Api.RGB(27, 102, 201));
var stroke = Api.CreateStroke(0, Api.CreateNoFill());
var shape = Api.CreateShape("roundRect", 220 * 36000, 55 * 36000, fill, stroke);
shape.SetPosition(30 * 36000, 35 * 36000);
shape.GetContent().GetElement(0).AddText("Slide title from inspected evidence");
slide.AddObject(shape);
// Exact slide/shape methods: slide-apiBuilder.js.
var outputPath = Argument["output"];
builder.SaveFile("pptx", "jsValue(outputPath)");
builder.CloseFile();''',
    "pdf-create": BRIDGE_COMMENT + r'''
// Native from-scratch PDF. Author content through the Word document surface,
// then save as PDF; builder.CreateFile("docx") is intentional here.
builder.CreateFile("docx");
var document = Api.GetDocument();
document.GetElement(0).AddText("Document title from inspected evidence");
var paragraph = Api.CreateParagraph();
paragraph.AddText("Body text grounded in the workspace evidence");
document.Push(paragraph);
// Exact paragraph/run/table methods: word-apiBuilder.js.
var outputPath = Argument["output"];
builder.SaveFile("pdf", "jsValue(outputPath)");
builder.CloseFile();''',
}


BRIDGE_TOKEN = re.compile(r"\bArgument\.(input|output)\b")
BRIDGE_CALL = re.compile(r"^\s*builder\.(\w+)\s*\(")
QUOTED_SPAN = re.compile(r'"[^"]*"')


def bridge_misuse_findings(script_text: str) -> list[dict[str, object]]:
    """Detect the one proven host-bridge misuse before any engine launch.

    Narrow by design: only a bare ``Argument.input``/``Argument.output`` in
    the argument list of a line-leading ``builder.*()`` native command is
    flagged — the exact failure that produced empty-path save errors. The
    engine parses such lines itself and only extracts quote-delimited
    strings, so a bare JavaScript expression can never reach it. Quoted
    text (including the literal "jsValue(name)" bridge) always passes.
    """

    findings: list[dict[str, object]] = []
    for number, line in enumerate(script_text.splitlines(), start=1):
        call = BRIDGE_CALL.match(line)
        if call is None:
            continue
        remainder = QUOTED_SPAN.sub('""', line[call.end() - 1 :])
        misuse = BRIDGE_TOKEN.search(remainder)
        if misuse is None:
            continue
        findings.append(
            {
                "line": number,
                "method": call.group(1),
                "token": f"Argument.{misuse.group(1)}",
            }
        )
    return findings


def bridge_misuse_message(findings: list[dict[str, object]]) -> str:
    first = findings[0]
    sites = ", ".join(
        f"line {item['line']}: builder.{item['method']}(... {item['token']} ...)"
        for item in findings[:8]
    )
    return (
        f"bridge_contract: {sites}. The Document Builder native command parser "
        "only reads quote-delimited strings, so a bare JavaScript expression "
        "arrives as an empty path (the historical 'save file error (88)' / "
        "'Empty sFileFrom or sFileTo' failure). Use the literal jsValue "
        "bridge instead:\n"
        f"  var outputPath = Argument[\"output\"];\n"
        f"  builder.{first['method']}(\"docx\", \"jsValue(outputPath)\");\n"
        "  var inputPath = Argument[\"input\"];\n"
        "  builder.OpenFile(\"jsValue(inputPath)\");\n"
        "The quoted \"jsValue(name)\" text is passed through exactly as "
        "written; the engine resolves the JavaScript variable itself. Static "
        "literal workspace paths in quotes also remain valid."
    )


class ContractError(ValueError):
    """Raised when a caller violates the local workspace contract."""


def _install_root() -> Path:
    return Path(os.environ.get("NHO_INSTALL_ROOT", "/opt/neoharness-office"))


def _is_within(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
    except ValueError:
        return False
    return True


def _exact_input(raw: str, root: Path, *, label: str) -> Path:
    path = Path(raw)
    if not path.is_absolute():
        raise ContractError(f"{label} must be an absolute path beneath {root}")
    try:
        resolved = path.resolve(strict=True)
    except FileNotFoundError as exc:
        raise ContractError(f"{label} does not exist: {path}") from exc
    if not _is_within(resolved, root):
        raise ContractError(f"{label} must remain beneath {root}")
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise ContractError(f"{label} must be a regular file and not a symlink")
    return resolved


def _exact_artifact_input(raw: str, *, label: str) -> Path:
    path = Path(raw)
    if not path.is_absolute():
        raise ContractError(f"{label} must be an absolute path beneath /workspace")
    try:
        resolved = path.resolve(strict=True)
    except FileNotFoundError as exc:
        raise ContractError(f"{label} does not exist: {path}") from exc
    if not any(_is_within(resolved, root) for root in ARTIFACT_READ_ROOTS):
        raise ContractError(f"{label} must remain beneath /workspace")
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise ContractError(f"{label} must be a regular file and not a symlink")
    return resolved


def _exact_output(
    raw: str, *, label: str, require_absent: bool = False
) -> Path:
    path = Path(raw)
    if not path.is_absolute():
        raise ContractError(f"{label} must be an absolute path beneath {OUTPUT_ROOT}")
    parent = path.parent.resolve(strict=True)
    resolved = parent / path.name
    if not _is_within(resolved, OUTPUT_ROOT):
        raise ContractError(f"{label} must remain beneath {OUTPUT_ROOT}")
    if path.exists() or path.is_symlink():
        info = path.lstat()
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
            raise ContractError(f"{label} may only replace a regular file")
        if require_absent:
            raise ContractError(
                f"{label} must be a fresh path so finalizer ownership is provable"
            )
    return resolved


def _load_argument(path: str | None) -> object:
    if path is None:
        return {}
    argument_path = _exact_input(path, WORK_ROOT, label="argument")
    try:
        with argument_path.open("r", encoding="utf-8") as source:
            return json.load(source)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ContractError(f"argument must contain valid UTF-8 JSON: {exc}") from exc


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _mime_type(path: Path) -> str:
    try:
        result = subprocess.run(
            ["file", "--brief", "--mime-type", "--", str(path)],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=10,
        )
        value = result.stdout.strip()
        if value:
            return value
    except (OSError, subprocess.SubprocessError):
        pass
    return mimetypes.guess_type(path.name)[0] or "application/octet-stream"


def _append_bounded(target: bytearray, chunk: bytes, limit: int) -> None:
    remaining = limit - len(target)
    if remaining > 0:
        target.extend(chunk[:remaining])


def _terminate_group(process: subprocess.Popen[bytes], grace_seconds: float = 2.0) -> None:
    if process.poll() is not None:
        return
    try:
        os.killpg(process.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    try:
        process.wait(timeout=grace_seconds)
        return
    except subprocess.TimeoutExpired:
        pass
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        return
    process.wait()


def _run_bounded(
    command: Sequence[str],
    *,
    cwd: Path,
    env: dict[str, str],
    timeout_seconds: float,
    diagnostic_limit: int,
) -> tuple[int, bytes, bytes, int, int, bool]:
    process = subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        cwd=cwd,
        env=env,
        start_new_session=True,
    )
    assert process.stdout is not None
    assert process.stderr is not None

    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ, "stdout")
    selector.register(process.stderr, selectors.EVENT_READ, "stderr")

    captured = {"stdout": bytearray(), "stderr": bytearray()}
    totals = {"stdout": 0, "stderr": 0}
    deadline = time.monotonic() + timeout_seconds
    timed_out = False

    while selector.get_map():
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            timed_out = True
            _terminate_group(process)
            remaining = 0
        events = selector.select(timeout=min(max(remaining, 0), 0.25))
        if not events and process.poll() is not None:
            events = [(key, selectors.EVENT_READ) for key in selector.get_map().values()]
        for key, _ in events:
            stream = key.fileobj
            chunk = os.read(stream.fileno(), 64 * 1024)
            if not chunk:
                selector.unregister(stream)
                stream.close()
                continue
            name = key.data
            totals[name] += len(chunk)
            _append_bounded(captured[name], chunk, diagnostic_limit)

    if process.poll() is None:
        if timed_out:
            _terminate_group(process)
        else:
            process.wait()

    return (
        EXIT_TIMEOUT if timed_out else int(process.returncode or 0),
        bytes(captured["stdout"]),
        bytes(captured["stderr"]),
        totals["stdout"],
        totals["stderr"],
        timed_out,
    )


def _quality_policy_identity() -> dict[str, str]:
    path = _install_root() / "share" / "runtime" / "quality-policy.v1.json"
    try:
        raw = path.read_bytes()
        policy = json.loads(raw)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ContractError(
            f"installed quality policy is unavailable or invalid: {exc}"
        ) from exc
    if not isinstance(policy, dict) or policy.get("schema") != QUALITY_POLICY_SCHEMA:
        raise ContractError("installed quality policy has an unsupported schema")
    version = policy.get("version")
    if not isinstance(version, str) or not version:
        raise ContractError("installed quality policy has no version")
    return {"version": version, "sha256": hashlib.sha256(raw).hexdigest()}


def _artifact(path: Path, *, quality_policy: dict[str, str]) -> dict[str, object]:
    info = path.lstat()
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode):
        raise ContractError(f"produced output is not a regular no-follow file: {path}")
    resolved = path.resolve(strict=True)
    if not _is_within(resolved, OUTPUT_ROOT):
        raise ContractError(f"produced output escaped {OUTPUT_ROOT}: {path}")
    fact: dict[str, object] = {
        "path": str(path),
        "name": path.name,
        "size": info.st_size,
        "sha256": _sha256(path),
        "mime_type": _mime_type(path),
    }
    fact["provenance"] = {
        "schema": ARTIFACT_PROVENANCE_SCHEMA,
        "policy": dict(quality_policy),
        "finalizer": {
            "class": "native_office",
            "producer": "docbuilder",
            "operation": "run",
        },
        "artifact": dict(fact),
    }
    return fact


def _write_json_atomic(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    encoded = json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n"
    with temporary.open("x", encoding="utf-8") as target:
        target.write(encoded)
        target.flush()
        os.fsync(target.fileno())
    os.replace(temporary, path)


def _version() -> str:
    path = _install_root() / "VERSION"
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return "development"


def _examples(args: argparse.Namespace) -> int:
    print(EXAMPLES[args.topic])
    return 0


_JS_EXCEPTION = re.compile(
    r"^.*\b(SyntaxError|ReferenceError|TypeError|RangeError)\b.*$", re.MULTILINE
)


def _classify_failure(
    *,
    status: str,
    engine_returncode: int,
    stdout_text: str,
    stderr_text: str,
    expected_outputs: Sequence[Path],
    artifacts: Sequence[dict[str, object]],
    artifact_errors: Sequence[str],
) -> dict[str, object] | None:
    """Classify a failed run from launcher-observable facts only.

    Every branch is derived from the exit status and the captured streams;
    hints describe mechanisms reproduced against this exact engine, never
    invented details about the specific run.
    """

    if status == "succeeded":
        return None
    if status == "timed_out":
        return {
            "class": "timeout",
            "detail": "the engine exceeded the wall timeout and was terminated",
        }
    if status == "terminated":
        return {
            "class": "terminated_by_signal",
            "signal": -engine_returncode,
        }
    diagnostics = f"{stdout_text}\n{stderr_text}"
    if engine_returncode != 0:
        if not stdout_text.strip() and not stderr_text.strip():
            return {
                "class": "engine_silent_failure",
                "detail": (
                    "the engine exited nonzero without emitting any stdout or "
                    "stderr"
                ),
                "hint": (
                    "reproduced cause: a file-open native command that fails "
                    "silently (for example an empty path from a host-bridge "
                    "misuse) also discards every queued script statement, so "
                    "nothing ever prints; verify OpenFile/SaveFile arguments "
                    'use the literal "jsValue(variableName)" bridge and that '
                    "declared inputs exist"
                ),
            }
        exception_line = _JS_EXCEPTION.search(diagnostics)
        if exception_line is not None:
            failure: dict[str, object] = {
                "class": "js_exception",
                "evidence": exception_line.group(0).strip()[:400],
            }
            if "Unexpected end of input" in diagnostics:
                failure["hint"] = (
                    "the engine executes each line whose trimmed start is "
                    "builder.* as a native command and splits the surrounding "
                    "JavaScript into separate chunks; a builder.*() call "
                    "inside an if/try/loop block truncates that block — keep "
                    "builder.*() calls at the top level of the script"
                )
            elif "builder is not defined" in diagnostics:
                failure["hint"] = (
                    "builder is not a JavaScript global; it is only a native "
                    "command at the start of a line, so pure JavaScript "
                    "expressions (typeof builder, builder.X inside larger "
                    "expressions) cannot reference it"
                )
            return failure
        if (
            "Empty sFileFrom or sFileTo" in diagnostics
            or "save file error" in diagnostics
        ):
            return {
                "class": "engine_error",
                "evidence": diagnostics.strip()[:400],
                "hint": (
                    "SaveFile/OpenFile native arguments are parsed as quoted "
                    "strings only; a bare JavaScript expression produces an "
                    'empty path — use var p = Argument["output"]; '
                    'builder.SaveFile("docx", "jsValue(p)")'
                ),
            }
        return {
            "class": "engine_error",
            "evidence": diagnostics.strip()[:400],
        }
    produced = {str(item.get("path", "")) for item in artifacts}
    missing = [str(item) for item in expected_outputs if str(item) not in produced]
    return {
        "class": "missing_artifact",
        "missing": missing,
        "artifact_errors": list(artifact_errors),
        "detail": (
            "the engine reported success but did not produce every declared "
            "output as a regular file"
        ),
    }


def _run(args: argparse.Namespace) -> int:
    started = time.monotonic()
    try:
        script = _exact_input(args.script, WORK_ROOT, label="script")
        misuse = bridge_misuse_findings(
            script.read_text(encoding="utf-8", errors="replace")
        )
        if misuse:
            raise ContractError(bridge_misuse_message(misuse))
        inputs = [_exact_artifact_input(item, label="input") for item in args.input]
        outputs = [
            _exact_output(item, label="output", require_absent=True)
            for item in args.output
        ]
        if not outputs:
            raise ContractError("at least one --output is required")
        if len(set(outputs)) != len(outputs):
            raise ContractError("each output path must be distinct")
        manifest_path = _exact_output(args.manifest, label="manifest")
        if manifest_path in outputs:
            raise ContractError("manifest path must be distinct from every output")
        user_argument = _load_argument(args.argument)
        quality_policy = _quality_policy_identity()
    except (ContractError, OSError) as exc:
        print(f"nh-office: {exc}", file=sys.stderr)
        return EXIT_DATA

    runtime_root = _install_root() / "documentserver"
    binary_root = runtime_root / "server" / "FileConverter" / "bin"
    docbuilder = binary_root / "docbuilder"
    if not docbuilder.is_file():
        print(f"nh-office: runtime binary is missing: {docbuilder}", file=sys.stderr)
        return EXIT_ENGINE

    engine_argument = {
        "input": str(inputs[0]) if inputs else None,
        "inputs": [str(item) for item in inputs],
        "output": str(outputs[0]),
        "outputs": [str(item) for item in outputs],
        "argument": user_argument,
    }
    compact_argument = json.dumps(engine_argument, separators=(",", ":"), ensure_ascii=False)

    env = dict(os.environ)
    existing_library_path = env.get("LD_LIBRARY_PATH")
    env["LD_LIBRARY_PATH"] = (
        f"{binary_root}:{existing_library_path}" if existing_library_path else str(binary_root)
    )

    command = [
        str(docbuilder),
        # Document Builder's native parser disables this flag only when the
        # value begins with "0"; the seemingly equivalent string "false"
        # enables it and would replace our deterministic cache with whatever
        # fonts happen to be visible on the host.
        "--check-fonts=0",
        "--fonts-system=false",
        f"--all-fonts-path={binary_root / 'AllFonts.js'}",
        f"--argument={compact_argument}",
        str(script),
    ]

    returncode, stdout, stderr, stdout_bytes, stderr_bytes, timed_out = _run_bounded(
        command,
        cwd=binary_root,
        env=env,
        timeout_seconds=args.timeout,
        diagnostic_limit=args.max_diagnostic_bytes,
    )

    artifacts: list[dict[str, object]] = []
    artifact_errors: list[str] = []
    for output in outputs:
        if not output.exists() and not output.is_symlink():
            continue
        try:
            artifacts.append(_artifact(output, quality_policy=quality_policy))
        except (ContractError, OSError) as exc:
            artifact_errors.append(str(exc))

    status = "succeeded"
    normalized_returncode = returncode
    if timed_out:
        status = "timed_out"
    elif returncode < 0:
        status = "terminated"
        normalized_returncode = EXIT_SIGNAL
    elif returncode != 0 or artifact_errors or len(artifacts) != len(outputs):
        status = "failed"
        normalized_returncode = EXIT_ENGINE

    failure = _classify_failure(
        status=status,
        engine_returncode=returncode,
        stdout_text=stdout.decode("utf-8", errors="replace"),
        stderr_text=stderr.decode("utf-8", errors="replace"),
        expected_outputs=outputs,
        artifacts=artifacts,
        artifact_errors=artifact_errors,
    )
    manifest = {
        "schema": "ai.neoharness.office.runtime-result.v1",
        "runtime_version": _version(),
        "quality_policy": quality_policy,
        "status": status,
        "exit_code": normalized_returncode,
        "engine_exit_code": returncode,
        "duration_ms": round((time.monotonic() - started) * 1000),
        "command": "docbuilder",
        "inputs": [str(item) for item in inputs],
        "expected_outputs": [str(item) for item in outputs],
        "artifacts": artifacts,
        "artifact_errors": artifact_errors,
        "failure": failure,
        "diagnostics": {
            "stdout": stdout.decode("utf-8", errors="replace"),
            "stderr": stderr.decode("utf-8", errors="replace"),
            "stdout_bytes": stdout_bytes,
            "stderr_bytes": stderr_bytes,
            "stdout_truncated": stdout_bytes > len(stdout),
            "stderr_truncated": stderr_bytes > len(stderr),
        },
    }
    try:
        _write_json_atomic(manifest_path, manifest)
    except OSError as exc:
        print(f"nh-office: could not write manifest: {exc}", file=sys.stderr)
        return EXIT_ENGINE

    if stdout:
        sys.stdout.buffer.write(stdout)
        if not stdout.endswith(b"\n"):
            sys.stdout.buffer.write(b"\n")
    if stderr:
        sys.stderr.buffer.write(stderr)
        if not stderr.endswith(b"\n"):
            sys.stderr.buffer.write(b"\n")
    for error in artifact_errors:
        print(f"nh-office: {error}", file=sys.stderr)

    summary: dict[str, object] = {"manifest": str(manifest_path), "status": status}
    if failure is not None:
        summary["failure_class"] = failure["class"]
    print(json.dumps(summary, sort_keys=True))
    return normalized_returncode


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="nh-office",
        description="Run source-built neoHarness Office operations in an exact workspace.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent(
            """\
            Start here:
              nh-document inspect /workspace/input/source.xlsx --output /workspace/work/inspection.json
              nh-office examples xlsx-revise
              nh-office examples docx-create
              nh-office run /workspace/work/edit.js \\
                --input /workspace/input/source.xlsx \\
                --output /workspace/output/candidate.xlsx \\
                --argument /workspace/work/argument.json \\
                --manifest /workspace/output/edit-manifest.json

            Exact API references:
              /opt/neoharness-office/share/api-reference/builder-host.js
              /opt/neoharness-office/share/api-reference/word-apiBuilder.js
              /opt/neoharness-office/share/api-reference/cell-apiBuilder.js
              /opt/neoharness-office/share/api-reference/slide-apiBuilder.js
              /opt/neoharness-office/share/api-reference/pdf-apiBuilder.js

            builder-host.js documents the builder.* native command surface
            (CreateFile/OpenFile/SaveFile/CloseFile/SetTmpFolder) and the
            literal "jsValue(variableName)" dynamic-path bridge. Dynamic
            paths never work as bare Argument.* expressions inside builder
            calls. Inspect the actual file and customize exact sheets,
            ranges, and operations before running an example. Friendly
            download names are supplied at publication time; workspace paths
            are internal.
            """
        ),
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {_version()}")
    subparsers = parser.add_subparsers(dest="command", required=True)
    run = subparsers.add_parser("run", help="execute a Document Builder JavaScript program")
    run.add_argument("script", help="absolute script path beneath /workspace/work")
    run.add_argument(
        "--input",
        action="append",
        default=[],
        help=(
            "exact regular file beneath /workspace/input, /workspace/work, or "
            "/workspace/output; repeatable"
        ),
    )
    run.add_argument(
        "--output",
        action="append",
        default=[],
        help="expected regular output file beneath /workspace/output; repeatable",
    )
    run.add_argument(
        "--argument",
        help="optional UTF-8 JSON file beneath /workspace/work",
    )
    run.add_argument(
        "--manifest",
        default=str(DEFAULT_MANIFEST),
        help=f"result manifest path beneath /workspace/output (default: {DEFAULT_MANIFEST})",
    )
    run.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT_SECONDS,
        help=f"wall timeout in seconds (default: {DEFAULT_TIMEOUT_SECONDS:g})",
    )
    run.add_argument(
        "--max-diagnostic-bytes",
        type=int,
        default=DEFAULT_DIAGNOSTIC_LIMIT,
        help=f"maximum captured bytes per stream (default: {DEFAULT_DIAGNOSTIC_LIMIT})",
    )
    run.set_defaults(handler=_run)
    examples = subparsers.add_parser(
        "examples",
        help="print a native edit starting script",
        description=(
            "Print a native edit starting script. Inspect the real file first, "
            "then customize the script before execution."
        ),
    )
    examples.add_argument("topic", choices=sorted(EXAMPLES))
    examples.set_defaults(handler=_examples)
    return parser


def main() -> int:
    parser = _parser()
    args = parser.parse_args()
    if getattr(args, "timeout", 1) <= 0:
        parser.error("--timeout must be greater than zero")
    if getattr(args, "max_diagnostic_bytes", 1) < 0:
        parser.error("--max-diagnostic-bytes cannot be negative")
    return int(args.handler(args))


if __name__ == "__main__":
    raise SystemExit(main())
